# ── Сайт ────────────────────────────────────────────────
PUBLIC_URL=https://news.sorpredente.com
# ОБЯЗАТЕЛЬНО, не короче 32 символов: python -c "import secrets; print(secrets.token_urlsafe(32))"
SESSION_SECRET=
TIMEZONE=Europe/Prague
WEB_PORT=8095
CLOUDFLARE_TUNNEL_TOKEN=

# ── Модель (как в piano-piano) ──────────────────────────
# kimi | anthropic | fake (без ключа — заглушки для разработки)
LLM_PROVIDER=kimi
LLM_MODEL=kimi-k2.6
LLM_API_KEY=

# ── Озвучка: OpenAI gpt-4o-mini-tts (≈$0.015 за минуту) ─
# openai | dummy (бип-бип для разработки)
TTS_PROVIDER=openai
TTS_API_KEY=
TTS_MODEL=gpt-4o-mini-tts
ANCHOR_VOICE=cedar
REPORTER_VOICE=marin
# Характер голосов можно поменять текстом: ANCHOR_INSTRUCTIONS=... REPORTER_INSTRUCTIONS=...

# Клопик: прямые включения на главных сюжетах
REPORTER_ENABLED=true
REPORTERS_PER_EDITION=2

# Поиск ИИ-ивентов в Праге для блока «ИИ в Праге» (тот же ключ, что в piano-piano). Пусто — только страницы-афиши
BRAVE_API_KEY=

# ── Telegram ────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=KlopNewsBot
# ОБЯЗАТЕЛЬНО: Telegram ID семьи через запятую (узнать у @userinfobot). Пусто — пускать всех, но только без https (разработка)
ALLOWED_TELEGRAM_IDS=
# Кому открыта панель /admin (просмотры, люди, выпуски). Вход — командой /admin в боте.
ADMIN_TELEGRAM_IDS=

# ── Расписание ──────────────────────────────────────────
EDITION_TIME=05:30
DEFAULT_DELIVERY_TIME=07:30
DEFAULT_MINUTES=10
